<section class="panel controls">
  <button class="btn-primary" type="button" onclick="openMaterialModal()">+ Novo Material</button>
  <button class="select" type="button">Ver reservas</button>
  <button class="select" type="button" id="btnMyRequests">Minhas reservas</button>
  <button class="select" id="1" type="button">Categoria <span>▾</span></button>
  <button class="btn-muted" type="button">Limpar Filtro</button>
</section>

<section class="panel" id="materialsPanel">
  <div class="panel-head">
    <h2>
      Lista de Materiais
      <span class="badge">{{dados.length}} materiais encontrados</span>
    </h2>

    <!-- Seletor de visualização (Card / Tabela) posicionado no cabeçalho da lista -->
    <div class="view-switch" role="group" aria-label="Modo de visualização">
      <button
        type="button"
        class="view-btn active"
        id="viewCardBtn"
        onclick="switchView('card')"
        title="Ver em cards"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ><rect x="3" y="3" width="7" height="7" /><rect
            x="14"
            y="3"
            width="7"
            height="7"
          /><rect x="3" y="14" width="7" height="7" /><rect
            x="14"
            y="14"
            width="7"
            height="7"
          /></svg>
      </button>
      <button
        type="button"
        class="view-btn"
        id="viewTableBtn"
        onclick="switchView('table')"
        title="Ver em tabela"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ><polyline points="9 11 12 14 22 4" /><path
            d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
          /></svg>
      </button>
    </div>
  </div>

  <!-- Visualização em Cards (Padrão) -->
  <div class="grid" id="materialsGrid">
    {{#each dados}}
      <article class="card">
        <div class="card-media">
          {{#if this.photo}}
            <img src="{{this.photo}}" alt="{{this.name}}" loading="lazy" />
          {{else}}
            <img
              src="/images/sem-foto.jpg"
              alt="{{this.name}}"
              loading="lazy"
            />
          {{/if}}
          <span class="tag tag-{{this.status}}">{{statusLabel
              this.status
            }}</span>
        </div>
        <div class="card-body">
          <h3>{{this.name}}</h3>
          <p class="description">{{this.description}}</p>

          <!-- Estoque reestruturado em badge moderna -->
          <div class="card-meta">
            <div class="meta-item">
              <span class="meta-label">Estoque</span>
              <span class="meta-value">{{this.qty}}</span>
            </div>
          </div>

          <div class="card-actions">
            <button
              class="btn-outline btn-view-material"
              type="button"
              data-name="{{this.name}}"
              data-category="{{this.category}}"
              data-qty="{{this.qty}}"
              data-description="{{this.description}}"
              data-notes="{{this.notes}}"
              data-photo="{{this.photo}}"
            >Visualizar</button>
            <button class="btn-outline" type="button">Editar</button>
            <button
              class="btn-danger"
              type="button"
              aria-label="Excluir"
            >🗑</button>
          </div>
        </div>
      </article>
    {{else}}
      <p class="empty-state">Nenhum material cadastrado ainda.</p>
    {{/each}}
  </div>

  <!-- Visualização em Tabela (Inicialmente oculta) -->
  <div id="tableView" class="hidden">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Categoria</th>
          <th>Estoque</th>
          <th>Status</th>
          <th class="text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each dados}}
          <tr>
            <td class="table-name">{{this.name}}</td>
            <td class="table-muted">{{this.category}}</td>
            <td>{{this.qty}}</td>
            <td><span class="tag tag-{{this.status}}">{{statusLabel
                  this.status
                }}</span></td>
            <td class="text-right">
              <button
                class="btn-outline btn-view-material btn-table-view"
                type="button"
                data-name="{{this.name}}"
                data-category="{{this.category}}"
                data-qty="{{this.qty}}"
                data-description="{{this.description}}"
                data-notes="{{this.notes}}"
                data-photo="{{this.photo}}"
              >Ver</button>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="5" class="empty-state">Nenhum material cadastrado
              ainda.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <nav class="pagination">
    <button class="page-nav" type="button" disabled>‹ Anterior</button>
    <button class="page current" type="button">1</button>
    <button class="page" type="button">2</button>
    <button class="page-nav" type="button">Próxima ›</button>
  </nav>
</section>

<!-- ===== Seção: Minhas Reservas ===== -->
<section class="panel hidden" id="myRequestsSection">
  <div class="panel-head">
    <h2>
      Minhas Reservas
      <span class="badge" id="requestsCountBadge">0 itens</span>
    </h2>
    <button class="btn-back" type="button" id="backToMaterialsBtn">Voltar</button>
  </div>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Material</th>
          <th>Matrícula</th>
          <th>Data da Solicitação</th>
          <th>Devolução Prevista</th>
          <th>Status</th>
          <th class="text-right">Ações</th>
        </tr>
      </thead>
      <tbody id="myRequestsTableBody">
        <!-- Exemplo de item estático por enquanto para testar o layout -->
        <tr>
          <td class="table-name">Notebook Dell</td>
          <td>20231024</td>
          <td>07/10/2026</td>
          <td>14/10/2026</td>
          <td><span class="tag tag-emprestado">Pendente</span></td>
          <td class="text-right">
            <button
              class="btn-outline btn-sm"
              type="button"
              onclick="alert('Cancelar reserva')"
            >Cancelar</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<!-- ===== Modal: Novo Material ===== -->
<div
  class="modal-overlay hidden"
  id="materialModalOverlay"
  onclick="closeMaterialModal()"
>
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="materialModalTitle"
    onclick="event.stopPropagation()"
  >
    <div class="modal-head">
      <h2 id="materialModalTitle">Cadastrar material</h2>
      <button
        class="modal-close"
        type="button"
        aria-label="Fechar"
        onclick="closeMaterialModal()"
      >✕</button>
    </div>

    <form class="modal-form" action="/materials" method="POST">
      <label class="field">
        <span>Nome</span>
        <input
          type="text"
          name="name"
          placeholder="Ex: Vestido de noiva"
          required
        />
      </label>

      <label class="field">
        <span>Categoria</span>
        <select name="category" required>
          <option value="" disabled selected>Selecione uma categoria</option>
          <option value="figurino">Figurino</option>
          <option value="adereços">Adereços</option>
          <option value="tecidos">Tecidos</option>
          <option value="material_cenografico">Material Cenográfico</option>
          <option value="livros">Livros</option>
          <option value="sala_de_isntrumentos">Sala de Instrumentos</option>
          <option value="laboratorio_de_musica">Laboratório de Música</option>
        </select>
      </label>

      <label class="field">
        <span>Quantidade em estoque</span>
        <input type="number" name="qty" min="0" placeholder="0" required />
      </label>

      <label class="field">
        <span>Descrição</span>
        <textarea
          name="description"
          rows="3"
          placeholder="Características físicas do item (cor, tamanho, material...)"
          required
        ></textarea>
      </label>

      <label class="field">
        <span>Observações</span>
        <textarea
          name="notes"
          rows="2"
          placeholder="Alguma observação sobre o estado, uso ou conservação"
          required
        ></textarea>
      </label>

      <label class="field">
        <span>Foto (link da imagem)</span>
        <input
          type="url"
          name="photo"
          placeholder="https://exemplo.com/foto.jpg"
        />
      </label>

      <div class="modal-actions">
        <button
          type="button"
          class="btn-outline"
          onclick="closeMaterialModal()"
        >Cancelar</button>
        <button type="submit" class="btn-primary">Cadastrar Material</button>
      </div>
    </form>
  </div>
</div>

<!-- ===== Modal: Visualizar Material ===== -->
<div
  class="modal-overlay hidden"
  id="viewMaterialModalOverlay"
  onclick="closeViewMaterialModal()"
>
  <div
    class="modal view-material-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="viewMaterialModalTitle"
    onclick="event.stopPropagation()"
  >

    <div class="modal-head view-material-head">
      <h2 id="viewMaterialModalTitle">Detalhes do Material</h2>
      <button
        class="modal-close"
        type="button"
        aria-label="Fechar"
        onclick="closeViewMaterialModal()"
      >✕</button>
    </div>

    <div class="view-material-body">
      <!-- Lado Esquerdo: Imagem -->
      <div class="view-material-media" id="viewModalPhotoContainer">
        <img id="viewModalPhoto" src="" alt="Foto do material" />
      </div>

      <!-- Lado Direito: Informações estruturadas -->
      <div class="view-material-info">
        <div class="field-group">
          <span class="field-label">Nome</span>
          <p id="viewModalName" class="field-value"></p>
        </div>

        <div class="field-group">
          <span class="field-label">Categoria</span>
          <p id="viewModalCategory" class="field-value"></p>
        </div>

        <div class="field-group">
          <span class="field-label">Quantidade em estoque</span>
          <p id="viewModalQty" class="field-value"></p>
        </div>

        <div class="field-group">
          <span class="field-label">Descrição</span>
          <p id="viewModalDescription" class="field-value"></p>
        </div>

        <div class="field-group">
          <span class="field-label alert-label">Observações</span>
          <p id="viewModalNotes" class="field-value alert-value"></p>
        </div>
      </div>
    </div>

    <div class="modal-actions view-material-actions">
      <button
        type="button"
        class="btn-outline"
        onclick="closeViewMaterialModal()"
      >Fechar</button>
      <button
        type="button"
        class="btn-primary"
        onclick="solicitarMaterialPopup()"
      >Solicitar Material</button>
    </div>

  </div>
</div>

<!-- ===== Modal: Solicitar Material (Novo) ===== -->
<div
  class="modal-overlay hidden"
  id="requestMaterialModalOverlay"
  onclick="closeRequestModal()"
>
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="requestModalTitle"
    onclick="event.stopPropagation()"
  >

    <div class="modal-head">
      <h2 id="requestModalTitle">Solicitar Empréstimo de Material</h2>
      <button
        class="modal-close"
        type="button"
        aria-label="Fechar"
        onclick="closeRequestModal()"
      >✕</button>
    </div>

    <form class="modal-form" action="/requests" method="POST">

      <!-- Campo oculto opcional para preencher o nome do material automaticamente via JS se precisar -->
      <input type="hidden" name="materialName" id="requestMaterialNameInput" />

      <label class="field">
        <span>Matrícula</span>
        <input
          type="text"
          name="matricula"
          placeholder="Digite sua matrícula"
          required
        />
      </label>

      <label class="field">
        <span>Nome Completo</span>
        <input type="text" name="nome" placeholder="Digite seu nome" required />
      </label>

      <label class="field">
        <span>Gmail (E-mail institucional)</span>
        <input
          type="email"
          name="email"
          placeholder="seu.email@escola.com"
          required
        />
      </label>

      <label class="field">
        <span>Telefone / WhatsApp</span>
        <input
          type="tel"
          name="telefone"
          placeholder="(00) 00000-0000"
          required
        />
      </label>

      <label class="field">
        <span>Data de Devolução Prevista</span>
        <input type="date" name="dataDevolucao" required />
      </label>

      <div class="modal-actions">
        <button
          type="button"
          class="btn-outline"
          onclick="closeRequestModal()"
        >Cancelar</button>
        <button type="submit" class="btn-primary">Confirmar Solicitação</button>
      </div>

    </form>
  </div>
</div>