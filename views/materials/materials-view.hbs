<section class="material-view">
  <a href="/materials" class="back-link"><i class="bi bi-arrow-left"></i>
    Voltar para Materiais</a>

  <div class="material-view-card">
    <div class="material-view-media">
      {{#if material.photo}}
        <img src="{{material.photo}}" alt="{{material.name}}" />
      {{else}}
        <img src="/images/sem-foto.jpg" alt="{{material.name}}" />
      {{/if}}

      {{#if material.status}}
        <span class="tag material-tag tag-{{material.status}}">
          <i class="bi bi-check2"></i>
          {{statusLabel material.status}}
        </span>
      {{/if}}
    </div>

    <div class="material-view-body">
      <h1>{{material.name}}</h1>

      <ul class="material-details">
        <li><i class="bi bi-tag"></i>
          <strong>Categoria:</strong>
          {{material.category}}</li>
        <li><i class="bi bi-box"></i>
          <strong>Quantidade:</strong>
          {{material.qty}}</li>
        {{#if material.notes}}
          <li><i class="bi bi-clipboard"></i>
            <strong>Notas:</strong>
            {{material.notes}}</li>
        {{/if}}
      </ul>

      <p class="material-view-description">{{material.description}}</p>

      <div class="material-view-actions">
        {{#if canManage}}
          <button
            type="button"
            class="btn-outline btn-editar btn-edit-material"
            data-id="{{material.id}}"
            data-name="{{material.name}}"
            data-category="{{material.category}}"
            data-qty="{{material.qty}}"
            data-description="{{material.description}}"
            data-notes="{{material.notes}}"
            data-photo="{{material.photo}}"
          ><i class="bi bi-pencil-square"></i> Editar</button>
        {{/if}}

        <button
          type="button"
          class="btn-primary btn-reservar"
          onclick="openRequestModalForMaterial('{{material.id}}')"
        >
          <i class="bi bi-calendar-plus"></i>
          Reservar
        </button>
      </div>
    </div>
  </div>
</section>

<script src="/javascripts/materials.js" defer></script>