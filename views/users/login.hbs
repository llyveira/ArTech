<!-- ===== Modal: Login ===== -->
<div class="modal-overlay hidden" id="loginModalOverlay" onclick="closeLoginModal()">
  <div class="modal login-modal" role="dialog" aria-modal="true" aria-labelledby="loginModalTitle" onclick="event.stopPropagation()">

    <section class="card">
      <!-- PAINEL VERDE -->
      <aside class="brand-panel">
        <div class="brand-panel-inner">
          <div class="logo-frame">
            <img src="/images/artech-logo.jpg" alt="Logo Artech" />
          </div>
          <h2>Arte, cultura e comunidade.</h2>
          <p>Conecte-se às atividades, eventos e recursos artísticos do IF.</p>
          <div class="secure-badge">
            <i class="bi bi-shield-check"></i>
            Ambiente seguro
          </div>
        </div>
      </aside>

      <!-- FORMULÁRIO -->
      <div class="form-panel">
        <button type="button" class="modal-close" aria-label="Fechar" onclick="closeLoginModal()">✕</button>

        <header>
          <h1 id="loginModalTitle">Login</h1>
          <p class="subtitle">Acesse sua conta</p>
        </header>

        <form id="loginForm">
          <div class="field">
            <label class="field-label" for="login">E-mail</label>
            <div class="field-box highlighted">
              <span class="field-icon"><i class="bi bi-envelope"></i></span>
              <input type="email" id="login" name="login" placeholder="seu.email@ifrn.edu.br" required />
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="password">Senha</label>
            <div class="field-box">
              <span class="field-icon"><i class="bi bi-lock"></i></span>
              <input class="password" type="password" id="password" name="password" placeholder="Digite sua senha" required />
              <button type="button" class="password-toggle" onclick="togglePassword('password', this)" aria-label="Mostrar senha">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <div class="options">
            <label class="remember">
              <input type="checkbox" name="remember" />
              <span>Lembrar de mim</span>
            </label>
            <a href="#" class="forgot">Esqueci a senha</a>
          </div>

          <button type="submit" class="btn-primary" id="submitBtn">
            <span>Entrar</span>
            <i class="bi bi-arrow-right"></i>
          </button>
        </form>

        <p class="register">
          Não tem uma conta?
          <a href="cadastro-interno.html">Cadastre-se</a>
        </p>

        <div class="legal-links">
          <a href="#">Termos de uso</a>
          <span>•</span>
          <a href="#">Política de privacidade</a>
        </div>
      </div>
    </section>

  </div>
</div>