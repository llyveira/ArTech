<link rel="stylesheet" href="/stylesheets/rooms.css" />

<div class="rooms-page">

  <div class="rooms-main">

  <!-- Hero -->
  <section class="rooms-hero">
    <div class="rooms-hero-text">
      <div class="rooms-hero-eyebrow">Espaços do NUARTE</div>
      <h1>Reserve o espaço certo para você</h1>
      <p>Consulte a disponibilidade das salas, solicite sua reserva e acompanhe tudo em um só lugar.</p>
    </div>
  </section>

  <!-- Toolbar -->
  <section class="rooms-toolbar">
    <div class="rooms-tabs">
      <button type="button" class="rooms-tab active" data-tab="salas">Salas disponíveis</button>
      <button type="button" class="rooms-tab" data-tab="reservas">Minhas reservas</button>
    </div>

    <div class="rooms-search-filters">
      <div class="rooms-search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
          <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input type="text" placeholder="Buscar sala..." />
      </div>
      <button type="button" class="rooms-filter">Tipo de sala <span class="arrow">▼</span></button>
      <button type="button" class="rooms-filter">Capacidade <span class="arrow">▼</span></button>
      <button type="button" class="btn-primary" onclick="openRoomModal()">+ Nova Reserva</button>
    </div>
  </section>

  <!-- Painel: Salas disponíveis -->
  <section class="rooms-panel" id="panel-salas">
    <div class="rooms-section">
      <div class="rooms-section-head">
        <h2>Salas do NUARTE</h2>
        <span class="rooms-section-count">5 salas encontradas</span>
      </div>

      <div class="rooms-grid">

        <!-- Card 1 -->
        <article class="room-card">
          <div class="room-card-top">
            <span class="room-badge livre">Livre agora</span>
          </div>
          <div>
            <div class="room-title">Sala de Música</div>
            <div class="room-meta"> Bloco NUARTE</div>
            <div class="room-meta"> Até 10 pessoas</div>
          </div>
          <div class="room-week">
            <div class="room-day"><div class="room-day-label">Seg</div><div class="room-day-dot fechado[]"></div></div>
            <div class="room-day"><div class="room-day-label">Ter</div><div class="room-day-dot livre"></div></div>
            <div class="room-day"><div class="room-day-label">Qua</div><div class="room-day-dot ocupado"></div></div>
            <div class="room-day"><div class="room-day-label">Qui</div><div class="room-day-dot livre"></div></div>
            <div class="room-day"><div class="room-day-label">Sex</div><div class="room-day-dot livre"></div></div>
          </div>
          <div class="room-card-actions">
            <a href="#" class="btn btn-outline">Ver detalhes</a>
            <button type="button" class="btn btn-primary" onclick="openRoomModal('Sala de Música')">Solicitar reserva</button>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="room-card">
          <div class="room-card-top">
            <span class="room-badge ocupada">Ocupada</span>
          </div>
          <div>
            <div class="room-title">Auditório</div>
            <div class="room-meta"> Bloco A</div>
            <div class="room-meta"> Até 40 pessoas</div>
          </div>
          <div class="room-card-actions">
            <a href="#" class="btn btn-outline">Ver detalhes</a>
            <button type="button" class="btn btn-primary" onclick="openRoomModal('Auditório')">Solicitar reserva</button>
          </div>
        </article>

        <!-- Card 3 -->
        <article class="room-card">
          <div class="room-card-top">
            <span class="room-badge livre">Livre agora</span>
          </div>
          <div>
            <div class="room-title">Lab. de Cenografia</div>
            <div class="room-meta"> Bloco NUARTE</div>
            <div class="room-meta"> Até 10 pessoas</div>
          </div>
          <div class="room-card-actions">
            <a href="#" class="btn btn-outline">Ver detalhes</a>
            <button type="button" class="btn btn-primary" onclick="openRoomModal('Lab. de Cenografia')">Solicitar reserva</button>
          </div>
        </article>

        <!-- Card 4 -->
        <article class="room-card">
          <div class="room-card-top">
            <span class="room-badge livre">Livre agora</span>
          </div>
          <div>
            <div class="room-title">Lab. de Música</div>
            <div class="room-meta"> Bloco NUARTE</div>
            <div class="room-meta"> Até 10 pessoas</div>
          </div>
          <div class="room-card-actions">
            <a href="#" class="btn btn-outline">Ver detalhes</a>
            <button type="button" class="btn btn-primary" onclick="openRoomModal('Lab. de Música')">Solicitar reserva</button>
          </div>
        </article>

        <!-- Card 5 -->
        <article class="room-card">
          <div class="room-card-top">
            <span class="room-badge ocupada">Ocupada</span>
          </div>
          <div>
            <div class="room-title">Sala Multiuso</div>
            <div class="room-meta"> Bloco NUARTE</div>
            <div class="room-meta"> Até 20 pessoas</div>
          </div>
          <div class="room-card-actions">
            <a href="#" class="btn btn-outline">Ver detalhes</a>
            <button type="button" class="btn btn-primary" onclick="openRoomModal('Sala Multiuso')">Solicitar reserva</button>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Painel: Minhas reservas -->
  <section class="rooms-panel" id="panel-reservas" hidden>
    <div class="rooms-section">
      <div class="rooms-section-head">
        <h2>Minhas reservas</h2>
        <span class="rooms-section-count">3 reservas</span>
      </div>

      <div class="reservations-list" id="reservationsList">
        <div class="reservation-row">

          <div class="reservation-info">
            <div class="reservation-room">Lab. de Música</div>
            <div class="reservation-time">Qui, 27 de agosto · 14h às 16h</div>
          </div>
          <span class="reservation-status confirmada">Confirmada</span>
          <button type="button" class="reservation-cancel" onclick="cancelReservation(this)">Cancelar</button>
        </div>

        <div class="reservation-row">
          
          <div class="reservation-info">
            <div class="reservation-room">Auditório</div>
            <div class="reservation-time">Sex, 28 de agosto · 9h às 11h</div>
          </div>
          <span class="reservation-status pendente">Pendente</span>
          <button type="button" class="reservation-cancel" onclick="cancelReservation(this)">Cancelar</button>
        </div>

        <div class="reservation-row">
          
          <div class="reservation-info">
            <div class="reservation-room">Lab. de Cenografia</div>
            <div class="reservation-time">Ter, 18 de agosto · 19h às 21h</div>
          </div>
          <span class="reservation-status cancelada">Cancelada</span>
          <button type="button" class="reservation-cancel" disabled style="opacity:.4;cursor:not-allowed;">Cancelar</button>
        </div>
      </div>
    </div>
  </section>

  </div>
  <!-- /rooms-main -->

  <!-- ===== Modal: Nova Reserva de Sala ===== -->
  <div class="modal-overlay hidden" id="roomModalOverlay" onclick="closeRoomModal()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="roomModalTitle" onclick="event.stopPropagation()">
      <div class="modal-head">
        <h2 id="roomModalTitle">Nova Reserva de Sala</h2>
        <button class="modal-close" type="button" aria-label="Fechar" onclick="closeRoomModal()">✕</button>
      </div>

      <form class="modal-form" id="roomReservationForm" onsubmit="return handleReservationSubmit(event)">
        <label class="field">
          <span>Sala</span>
          <select name="sala" id="reservaSala" required>
            <option value="" disabled selected>Selecione uma sala</option>
            <option value="Sala de Música">Sala de Música</option>
            <option value="Auditório">Auditório</option>
            <option value="Lab. de Cenografia">Lab. de Cenografia</option>
            <option value="Lab. de Música">Lab. de Música</option>
            <option value="Sala Multiuso">Sala Multiuso</option>
          </select>
        </label>

        <label class="field">
          <span>Data da reserva</span>
          <input type="date" name="date" required />
        </label>

        <label class="field">
          <span>Horário de início</span>
          <input type="time" name="startTime" required />
        </label>

        <label class="field">
          <span>Horário de término</span>
          <input type="time" name="endTime" required />
        </label>

        <label class="field">
          <span>Quantidade de participantes</span>
          <input type="number" name="participants" min="1" placeholder="Ex: 8" />
        </label>

        <label class="field">
          <span>Finalidade da reserva</span>
          <textarea name="purpose" rows="3" placeholder="Ex: Ensaio do coral, gravação, reunião de equipe..." required></textarea>
        </label>

        <label class="field">
          <span>Observações</span>
          <textarea name="notes" rows="2" placeholder="Alguma observação adicional (equipamentos, acessibilidade...)"></textarea>
        </label>

        <div class="modal-actions">
          <button type="button" class="btn-outline" onclick="closeRoomModal()">Cancelar</button>
          <button type="submit" class="btn-primary">Confirmar Reserva</button>
        </div>
      </form>
    </div>
  </div>

</div>
<!-- /rooms-page -->

<script>
  // Alternância visual entre abas (apenas front-end, sem integração ainda)
  document.querySelectorAll('.rooms-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.rooms-tab').forEach(function (t) { t.classList.remove('active'); });
      tab.classList.add('active');
      var target = tab.getAttribute('data-tab');
      document.getElementById('panel-salas').hidden = target !== 'salas';
      document.getElementById('panel-reservas').hidden = target !== 'reservas';
    });
  });

  // ===== Modal: Nova Reserva de Sala (apenas front-end, sem integração ainda) =====

  function openRoomModal(roomName) {
    document.getElementById('roomModalOverlay').classList.remove('hidden');
    var select = document.getElementById('reservaSala');
    if (roomName) {
      select.value = roomName;
    }
  }

  function closeRoomModal() {
    document.getElementById('roomModalOverlay').classList.add('hidden');
  }

  var MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
  var DIAS_SEMANA = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];

  function formatarData(isoDate) {
    if (!isoDate) return '';
    var partes = isoDate.split('-');
    var dataObj = new Date(Number(partes[0]), Number(partes[1]) - 1, Number(partes[2]));
    var diaSemana = DIAS_SEMANA[dataObj.getDay()];
    var mes = MESES[dataObj.getMonth()];
    return diaSemana + ', ' + dataObj.getDate() + ' de ' + mes;
  }

  function formatarHora(hora) {
    if (!hora) return '';
    return hora.replace(/^0/, '').replace(':00', 'h').replace(':', 'h');
  }

  // Envio do formulário: ainda sem integração com o back-end, apenas
  // adiciona a reserva visualmente em "Minhas reservas".
  function handleReservationSubmit(event) {
    event.preventDefault();

    var form = event.target;
    var sala = form.sala.value;
    var data = formatarData(form.date.value);
    var inicio = formatarHora(form.startTime.value);
    var fim = formatarHora(form.endTime.value);

    var row = document.createElement('div');
    row.className = 'reservation-row';
    row.innerHTML =
      '<div class="reservation-info">' +
        '<div class="reservation-room">' + sala + '</div>' +
        '<div class="reservation-time">' + data + ' · ' + inicio + ' às ' + fim + '</div>' +
      '</div>' +
      '<span class="reservation-status pendente">Pendente</span>' +
      '<button type="button" class="reservation-cancel" onclick="cancelReservation(this)">Cancelar</button>';

    document.getElementById('reservationsList').prepend(row);
    updateReservationCount();

    closeRoomModal();
    form.reset();

    // Leva o usuário para a aba "Minhas reservas" para ver o resultado
    document.querySelector('.rooms-tab[data-tab="reservas"]').click();
  }

  function cancelReservation(button) {
    button.closest('.reservation-row').remove();
    updateReservationCount();
  }

  function updateReservationCount() {
    var total = document.querySelectorAll('#reservationsList .reservation-row').length;
    document.querySelector('#panel-reservas .rooms-section-count').textContent =
      total + (total === 1 ? ' reserva' : ' reservas');
  }
</script>
