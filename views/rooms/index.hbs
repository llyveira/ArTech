<link rel="stylesheet" href="/stylesheets/rooms.css" />

<div class="rooms-page">

  <div class="rooms-main">
    
  <!-- Toolbar -->
  <section class="rooms-toolbar">
    <div class="rooms-toolbar-left">
      <button type="button" class="btn-primary" onclick="openRoomModal()">+ Nova Reserva</button>
      <div class="rooms-tabs">
        <button type="button" class="rooms-tab active" data-tab="salas">Salas disponíveis</button>
        <button type="button" class="rooms-tab" data-tab="reservas">Minhas reservas</button>
      </div>
    </div>

    <div class="rooms-search-filters">
      <button type="button" class="rooms-filter">Tipo de sala <span class="arrow">▼</span></button>
      <button type="button" class="rooms-filter">Capacidade <span class="arrow">▼</span></button>
    </div>
  </section>

  <!-- Painel: Salas disponíveis -->
  <section class="rooms-panel" id="panel-salas">
    <div class="rooms-section">
      <div class="rooms-section-head">
        <h2>Salas do NUARTE</h2>
        <span class="rooms-section-count">2 salas encontradas</span>
      </div>

      <div class="rooms-grid">

        <!-- Card 1 -->
        <article class="room-card">
          <div class="room-media">
            <!-- Espaço reservado para a imagem da sala: coloque <img src="..." alt="Lab. de Cenografia" /> aqui dentro -->
            <span class="room-badge livre">Livre agora</span>
          </div>
          <div class="room-body">
            <div>
              <div class="room-title">Lab. de Cenografia</div>
              <div class="room-meta"> Bloco NUARTE</div>
              <div class="room-meta"> Até 10 pessoas</div>
            </div>
            <div class="room-hours">
              <div class="room-hours-title">Horário de funcionamento</div>
              <div class="room-hours-row"><span>Manhã</span><strong>08h às 12h</strong></div>
              <div class="room-hours-row"><span>Tarde</span><strong>13h às 17h</strong></div>
            </div>
            <div class="room-card-actions">
              <a href="#" class="btn-outline">Ver detalhes</a>
              <button type="button" class="btn-primary" onclick="openRoomModal('Lab. de Cenografia')">Solicitar reserva</button>
            </div>
          </div>
        </article>

        <!-- Card 2 -->
        <article class="room-card">
          <div class="room-media">
            <!-- Espaço reservado para a imagem da sala: coloque <img src="..." alt="Lab. de Música" /> aqui dentro -->
            <span class="room-badge livre">Livre agora</span>
          </div>
          <div class="room-body">
            <div>
              <div class="room-title">Lab. de Música</div>
              <div class="room-meta"> Bloco NUARTE</div>
              <div class="room-meta"> Até 10 pessoas</div>
            </div>
            <div class="room-hours">
              <div class="room-hours-title">Horário de funcionamento</div>
              <div class="room-hours-row"><span>Manhã</span><strong>08h às 12h</strong></div>
              <div class="room-hours-row"><span>Tarde</span><strong>13h às 17h</strong></div>
            </div>
            <div class="room-card-actions">
              <a href="#" class="btn-outline">Ver detalhes</a>
              <button type="button" class="btn-primary" onclick="openRoomModal('Lab. de Música')">Solicitar reserva</button>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Painel: Minhas reservas -->
  <section class="rooms-panel" id="panel-reservas" hidden>
    <div class="rooms-section">
      <div class="rooms-section-head">
        <h2>Minhas reservas</h2>
        <span class="rooms-section-count">{{totalReservas}}</span>
      </div>

      <div class="reservations-list" id="reservationsList">
        {{#each reservas}}
        <div class="reservation-row">
          <div class="reservation-info">
            <div class="reservation-room">{{sala}}</div>
            <div class="reservation-time">{{horario}}</div>
          </div>
          <span class="reservation-status {{statusClass}}">{{statusTexto}}</span>
          {{#if podeCancelar}}
          <form action="/rooms/{{id}}/cancel" method="POST" class="reservation-cancel-form" onsubmit="return confirm('Cancelar esta reserva?')">
            <button type="submit" class="reservation-cancel">Cancelar</button>
          </form>
          {{/if}}
        </div>
        {{else}}
        <div class="reservation-empty">Você ainda não tem reservas.</div>
        {{/each}}
      </div>
    </div>
  </section>

  </div>
  <!-- /rooms-main -->

  <!-- ===== Modal: Nova Reserva de Sala ===== -->
  <div class="modal-overlay hidden" id="roomModalOverlay" onclick="closeRoomModal()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="roomModalTitle" onclick="event.stopPropagation()">
      <div class="modal-head">
        <h2 id="roomModalTitle">Nova Reserva de Sala</h2>
        <button class="modal-close" type="button" aria-label="Fechar" onclick="closeRoomModal()">✕</button>
      </div>

      <form class="modal-form" id="roomReservationForm" action="/rooms" method="POST">
        <label class="field">
          <span>Sala</span>
          <select name="sala" id="reservaSala" required>
            <option value="" disabled selected>Selecione uma sala</option>
            {{#each salas}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
        </label>

        <label class="field">
          <span>Data da reserva</span>
          <input type="date" name="date" required />
        </label>

        <label class="field">
          <span>Horário de início</span>
          <input type="time" name="startTime" required />
        </label>

        <label class="field">
          <span>Horário de término</span>
          <input type="time" name="endTime" required />
        </label>

        <label class="field">
          <span>Quantidade de participantes</span>
          <input type="number" name="participants" min="1" placeholder="Ex: 8" required />
        </label>

        <label class="field">
          <span>Finalidade da reserva</span>
          <textarea name="purpose" rows="3" placeholder="Ex: Ensaio do coral, gravação, reunião de equipe..." required></textarea>
        </label>

        <label class="field">
          <span>Observações</span>
          <textarea name="notes" rows="2" placeholder="Alguma observação adicional (equipamentos, acessibilidade...)"></textarea>
        </label>

        <div class="modal-actions">
          <button type="button" class="btn-outline" onclick="closeRoomModal()">Cancelar</button>
          <button type="submit" class="btn-primary">Confirmar Reserva</button>
        </div>
      </form>
    </div>
  </div>

</div>
<!-- /rooms-page -->

<script>
  // Alternância entre abas "Salas disponíveis" / "Minhas reservas"
  function selecionarAba(nome) {
    document.querySelectorAll('.rooms-tab').forEach(function (t) {
      t.classList.toggle('active', t.getAttribute('data-tab') === nome);
    });
    document.getElementById('panel-salas').hidden = nome !== 'salas';
    document.getElementById('panel-reservas').hidden = nome !== 'reservas';
  }

  document.querySelectorAll('.rooms-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      selecionarAba(tab.getAttribute('data-tab'));
    });
  });

  // Depois de salvar/cancelar, o servidor redireciona para /rooms?tab=reservas
  if (new URLSearchParams(window.location.search).get('tab') === 'reservas') {
    selecionarAba('reservas');
  }

  // ===== Modal: Nova Reserva de Sala =====

  // Abre o modal; se vier o nome de uma sala (botão do card), já deixa ela selecionada
  function openRoomModal(roomName) {
    document.getElementById('roomModalOverlay').classList.remove('hidden');
    if (roomName) {
      var select = document.getElementById('reservaSala');
      Array.prototype.forEach.call(select.options, function (opt) {
        if (opt.text === roomName) select.value = opt.value;
      });
    }
  }

  function closeRoomModal() {
    document.getElementById('roomModalOverlay').classList.add('hidden');
  }
</script>
