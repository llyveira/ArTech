<div class="modal-overlay hidden" id="registerModalOverlay">
  <div
    class="modal register-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="registerModalTitle"
  >
    <section class="card">


  <!-- CABEÇALHO DO MODAL -->
  <header class="form-panel-header">
    <div class="form-panel-title">
      <span class="form-panel-icon">
        <i class="bi bi-person-plus"></i>
      </span>

      <div>
        <h1 id="registerModalTitle">Criar conta</h1>
        <p class="subtitle">Cadastro de usuários</p>
      </div>
    </div>

    <button
      type="button"
      class="modal-close"
      id="closeRegisterButton"
      aria-label="Fechar"
    >
      <i class="bi bi-x-lg"></i>
    </button>
  </header>

  <!-- MENSAGEM DE SEGURANÇA -->
  <div class="auth-notice">
    <i class="bi bi-shield-check"></i>
    <span>Conexão protegida. Nunca pedimos sua senha por e-mail.</span>
  </div>

  <!-- FORMULÁRIO -->
  <div class="form-panel">
    <form id="registerForm" action="/users/register" method="POST">

      <!-- NOME -->
      <div class="input-group">
        <label for="registerName">
          Nome completo
        </label>

        <div class="input-wrapper">
          <i class="bi bi-person"></i>

          <input
            type="text"
            id="registerName"
            name="name"
            placeholder="Digite seu nome completo"
            autocomplete="name"
            required
          />
        </div>
      </div>

      <!-- E-MAIL -->
      <div class="input-group">
        <label for="registerEmail">
          E-mail
        </label>

        <div class="input-wrapper">
          <i class="bi bi-envelope"></i>

          <input
            type="email"
            id="registerEmail"
            name="email"
            placeholder="Digite seu e-mail"
            autocomplete="email"
            required
          />
        </div>
      </div>

      <!-- MATRÍCULA -->
      <div class="input-group">
        <label for="registerRegistration">
          Matrícula
          <span>(opcional, para usuários internos)</span>
        </label>

        <div class="input-wrapper">
          <i class="bi bi-card-text"></i>

          <input
            type="text"
            id="registerRegistration"
            name="registration"
            placeholder="Digite sua matrícula"
          />
        </div>
      </div>

      <!-- SENHA -->
      <div class="input-group">
        <label for="registerPassword">
          Senha
        </label>

        <div class="input-wrapper">
          <i class="bi bi-lock"></i>

          <input
            type="password"
            id="registerPassword"
            name="password"
            placeholder="Digite sua senha"
            autocomplete="new-password"
            required
          />

          <button
            type="button"
            class="toggle-password"
            id="toggleRegisterPassword"
            aria-label="Mostrar senha"
          >
            <i class="bi bi-eye"></i>
          </button>
        </div>
      </div>

      <!-- CONFIRMAÇÃO -->
      <div class="input-group">
        <label for="registerConfirmPassword">
          Confirmar senha
        </label>

        <div class="input-wrapper">
          <i class="bi bi-lock-fill"></i>

          <input
            type="password"
            id="registerConfirmPassword"
            name="confirmPassword"
            placeholder="Confirme sua senha"
            autocomplete="new-password"
            required
          />

          <button
            type="button"
            class="toggle-password"
            id="toggleRegisterConfirmPassword"
            aria-label="Mostrar confirmação de senha"
          >
            <i class="bi bi-eye"></i>
          </button>
        </div>
      </div>

      <!-- BOTÃO -->
      <button
        type="submit"
        class="submit-btn"
        id="registerSubmitBtn"
      >
        <i class="bi bi-person-plus"></i>
        Criar minha conta
      </button>

    </form>

    <!-- LOGIN -->
    <p class="register">
      Já possui uma conta?
      <a href="#" id="openLoginFromRegister">
        Entrar
      </a>
    </p>

    <!-- LINKS LEGAIS -->
    <div class="legal-links">
      <a href="#">Termos de uso</a>
      <span>•</span>
      <a href="#">Política de privacidade</a>
    </div>
  </div>

</section>


  </div>
</div>
