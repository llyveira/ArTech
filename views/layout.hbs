<html lang="pt-BR">

  <head>
    <meta charset="UTF-8" />
    <base href="{{baseHref}}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}} | Artech</title>
    <meta
      name="description"
      content="Painel para consultar o acervo de materiais do NUARTE do IFRN: figurinos, adereços, material cenográfico e equipamentos."
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <link rel="stylesheet" href="stylesheets/events.css" />
    <link rel="stylesheet" href="stylesheets/auth.css" />
    <link rel="stylesheet" href="stylesheets/style.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  </head>

  <body>
    <div class="layout">

      <aside class="sidebar">
        <a href="events">
          <div class="brand">
            <div class="brand-logo">
              <img src="images/artech-logo.jpg" alt="Logo Artech" />
            </div>
            <p class="brand-sub">Instituto Federal<br />Rio Grande do Norte</p>
            <p class="brand-name">NUARTE</p>
          </div>
        </a>

        <nav class="nav">
          <a href="javascript:void(0)">
            <i class="bi bi-grid"></i>
            Dashboard
          </a>
          <a href="events" class="">
            <i class="bi bi-calendar3"></i>
            Eventos
          </a>
          <a href="javascript:void(0)">
            <i class="bi bi-folder"></i>
            Categorias
          </a>
          <a href="materials">
            <i class="bi bi-box"></i>
            Materiais
          </a>
          <a href="rooms">
            <i class="bi bi-door-open"></i>
            Reserva de Sala
          </a>
          {{#if currentUser}}
          <a href="#" id="logoutButton" class="menu-item logout-item">
            <i class="bi bi-box-arrow-right"></i>
            <span>Sair</span>
          </a>
          {{/if}}
        </nav>

        <div class="auth-area">

          {{#if currentUser}}

          <div class="user-card" id="userCard">

            <span class="avatar">{{initials currentUser.name}}</span>

            <div>
              <p class="user-name" title="{{currentUser.email}}">{{shortName currentUser.name}}</p>
              <p class="user-role">{{roleName currentUser.profile}}</p>
            </div>

          </div>

          {{else}}

          <div class="auth-buttons" id="authButtons">

            <button
              type="button"
              class="auth-button register-button"
              onclick="openRegisterModal()"
            >
              <i class="bi bi-person-plus"></i>
              Cadastrar
            </button>

            <button
              type="button"
              class="auth-button login-button"
              onclick="openLoginModal()"
            >
              <i class="bi bi-box-arrow-in-right"></i>
              Entrar
            </button>

          </div>

          {{/if}}

        </div>
      </aside>

      <div class="content">
        <header class="topbar">
          <div>
            <h1>{{title}}</h1>
            <p class="subtitle">{{subtitle}}</p>
          </div>
          <div class="topbar-actions">
            <div class="search-wrap">
              <input
                class="search"
                id="globalSearchInput"
                type="search"
                placeholder="Pesquisar..."
                aria-label="Pesquisar"
                autocomplete="off"
              />
              <div class="search-results-dropdown hidden" id="globalSearchResults"></div>
            </div>
          </div>
        </header>

        <main class="main">
          {{! Não deletar }}
          {{#if restricted}}
          {{!-- No próximo teste, verificar se o "profile" é maior que 0 --}}
            {{#if currentUser}} 
              {{{body}}}
            {{else}}
              <section class="restricted-page">
                <div class="restricted-card">
                  <div class="restricted-icon"><i class="bi bi-lock"></i></div>
                  <h2>Acesso restrito</h2>
                  <p>O acesso a esta página é restrito a usuários autenticados. Faça login para continuar.</p>
                  <div class="restricted-actions">
                    <button type="button" class="btn-outline" onclick="openRegisterModal()">Criar conta</button>
                    <button type="button" class="btn-primary" onclick="openLoginModal()">Entrar</button>
                  </div>
                </div>
              </section>
            {{/if}}
          {{else}}
            {{{body}}}
          {{/if}}
        </main>

        <footer class="site-footer">
          <div class="footer-grid">
            <div class="footer-col">
              <h3 class="footer-heading">Sobre o Artech</h3>
              <p class="footer-title">Tecnologia aplicada à Gestão
                Artístico-cultural</p>
              <p class="footer-desc">Software para gestão e divulgação de
                atividades e recursos artísticos do NUARTE.</p>
              <ul class="footer-links">
                <li>
                  <a
                    href="https://portal.ifrn.edu.br/projetos-de-extensao/4277/"
                    target="_blank"
                    rel="noopener"
                  >
                    <svg
                      class="footer-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ><path
                        d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"
                      /><path
                        d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07l1.36-1.36"
                      /></svg>
                    Portal do NUARTE/SC
                  </a>
                </li>
                <li>
                  <a
                    href="https://portal.ifrn.edu.br/"
                    target="_blank"
                    rel="noopener"
                  >
                    <svg
                      class="footer-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ><path
                        d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"
                      /><path
                        d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07l1.36-1.36"
                      /></svg>
                    Portal do IFRN
                  </a>
                </li>
                <li>
                  <a
                    href="https://portal.ifrn.edu.br/campus/santacruz/"
                    target="_blank"
                    rel="noopener"
                  >
                    <svg
                      class="footer-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ><path
                        d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"
                      /><path
                        d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07l1.36-1.36"
                      /></svg>
                    Portal do IFRN/SC
                  </a>
                </li>
              </ul>
            </div>

            <div class="footer-col">
              <h3 class="footer-heading">Links úteis</h3>
              <ul class="footer-links">
                <li>
                  <a href="https://www.instagram.com/nuartesc" target="_blank" rel="noopener">
                    <svg
                      class="footer-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ><rect x="2" y="2" width="20" height="20" rx="5" /><circle
                        cx="12"
                        cy="12"
                        r="4"
                      /><circle
                        cx="17.5"
                        cy="6.5"
                        r="1"
                        fill="currentColor"
                        stroke="none"
                      /></svg>
                    Instagram do NUARTE
                  </a>
                </li>
                <li>
                  <a href="#" target="_blank" rel="noopener">
                    <svg
                      class="footer-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ><rect x="2" y="2" width="20" height="20" rx="5" /><circle
                        cx="12"
                        cy="12"
                        r="4"
                      /><circle
                        cx="17.5"
                        cy="6.5"
                        r="1"
                        fill="currentColor"
                        stroke="none"
                      /></svg>
                    Página dos Desenvolvedores
                  </a>
                </li>
              </ul>
            </div>

            <div class="footer-col">
              <h3 class="footer-heading">Informações técnicas</h3>
              <ul class="footer-info">
                <li>Versão: <strong>1.0.0</strong></li>
                <li>Curso:
                  <strong>Técnico Integrado em Informática — IFRN</strong></li>
                <li>Desenvolvido por: <strong>Equipe Artech</strong></li>
              </ul>
            </div>
          </div>

          <div class="footer-bottom">
            © 2026 NUARTE · Instituto Federal do Rio Grande do Norte — Campus
            Santa Cruz. Projeto
            <a href="#">Artech</a>.
          </div>
        </footer>
      </div>
    </div>

    <button class="help" type="button" aria-label="Ajuda">?</button>
    {{> login-modal}}
    {{> register-modal}}

    <!-- ===== Modal Global: Editar Material ===== -->
    <div class="modal-overlay hidden" id="editMaterialModalOverlay" onclick="closeEditMaterialModal()">
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="editMaterialModalTitle" onclick="event.stopPropagation()">
        
        <div class="modal-head">
          <h2 id="editMaterialModalTitle">Editar Material</h2>
          <button class="modal-close" type="button" aria-label="Fechar" onclick="closeEditMaterialModal()">✕</button>
        </div>

        <form class="modal-form" id="editMaterialForm" action="materials/update" method="POST">
          
          <input type="hidden" name="materialId" id="editModalId" />

          <label class="field">
            <span>Nome</span>
            <input type="text" name="name" id="editModalName" required />
          </label>

          <label class="field">
            <span>Categoria</span>
            <select name="category" id="editModalCategory" required>
              <option value="" disabled>Selecione uma categoria</option>
              <option value="figurino">Figurino</option>
              <option value="adereços">Adereços</option>
              <option value="tecidos">Tecidos</option>
              <option value="material_cenografico">Material Cenográfico</option>
              <option value="livros">Livros</option>
              <option value="sala_de_instrumentos">Sala de Instrumentos</option>
              <option value="laboratorio_de_musica">Laboratório de Música</option>
            </select>
          </label>

          <label class="field">
            <span>Quantidade em estoque</span>
            <input type="number" name="qty" id="editModalQty" min="0" required />
          </label>

          <label class="field">
            <span>Descrição</span>
            <textarea name="description" id="editModalDescription" rows="3" required></textarea>
          </label>

          <label class="field">
            <span>Observações</span>
            <textarea name="notes" id="editModalNotes" rows="2" required></textarea>
          </label>

          <label class="field">
            <span>Foto (link da imagem)</span>
            <input type="url" name="photo" id="editModalPhoto" />
          </label>

          <div class="modal-actions">
            <button type="button" class="btn-outline" onclick="closeEditMaterialModal()">Cancelar</button>
            <button type="submit" class="btn-primary">Salvar Alterações</button>
          </div>

        </form>
      </div>
    </div>

    <div
  class="modal-overlay hidden"
  id="requestMaterialModalOverlay"
  onclick="closeRequestModal()"
>
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="requestModalTitle"
    onclick="event.stopPropagation()"
  >

    <div class="modal-head">
      <h2 id="requestModalTitle">Solicitar Empréstimo de Material</h2>
      <button
        class="modal-close"
        type="button"
        aria-label="Fechar"
        onclick="closeRequestModal()"
      >✕</button>
    </div>

    <form class="modal-form" action="requests" method="POST">

      <input type="hidden" name="materialId" id="requestMaterialIdInput" />

      <label class="field">
        <span>Matrícula</span>
        <input
          type="text"
          name="matricula"
          placeholder="Digite sua matrícula"
          required
        />
      </label>

      <label class="field">
        <span>Nome Completo</span>
        <input type="text" name="nome" placeholder="Digite seu nome" required />
      </label>

      <label class="field">
        <span>Gmail (E-mail institucional)</span>
        <input
          type="email"
          name="email"
          placeholder="seu.email@escola.com"
          required
        />
      </label>

      <label class="field">
        <span>Telefone / WhatsApp</span>
        <input
          type="tel"
          name="telefone"
          placeholder="(00) 00000-0000"
          required
        />
      </label>

      <label class="field">
        <span>Data de Devolução Prevista</span>
        <input type="date" name="dataDevolucao" required />
      </label>

      <div class="modal-actions">
        <button
          type="button"
          class="btn-outline"
          onclick="closeRequestModal()"
        >Cancelar</button>
        <button type="submit" class="btn-primary">Confirmar Solicitação</button>
      </div>

    </form>
  </div>
</div>

    <script src="javascripts/materials.js"></script>
    <script src="javascripts/auth.js"></script>
    <script src="javascripts/search.js"></script>
  </body>

</html>