<link rel="stylesheet" href="stylesheets/auth.css" />

<section class="restricted-page">
  <div class="restricted-card">
    <div class="restricted-icon"><i class="bi bi-lock"></i></div>
    <h2>Acesso restrito</h2>
    <p>O acesso a esta página é restrito a usuários autenticados. Faça login para continuar.</p>
    <div class="restricted-actions">
      <button type="button" class="btn-outline" onclick="openRegisterModal()">Criar conta</button>
      <button type="button" class="btn-primary" onclick="openLoginModal()">Entrar</button>
    </div>
  </div>
</section>
