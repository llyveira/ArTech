<!-- Cabeçalho Principal -->
    {{!-- <header class="page-header">
      <div class="header-title">
        <h1>{{title}}</h1>
        <p>{{subtitle}}</p>
      </div>
      <div class="header-actions">
        <input type="search" placeholder="Pesquisar eventos...">
       
      </div>
    </header> --}}

    <!-- Filtros de Busca -->
    <section class="filters-section">

        <!-- Botão de Novo Evento -->
{{#if currentUser}}
  <button class="btn-novo-evento" type="button" onclick="abrirModalEvento('modalNovoEvento')">+ Novo Evento</button>
{{/if}}
    <select name="categoria">
        <option value="" disabled selected>Categoria</option>
        <option value="oficinas-artisticas">Oficinas artísticas</option>
        <option value="apresentacoes-culturais">Apresentações culturais</option>
        <option value="ensaios">Ensaios</option>
        <option value="exposicoes">Exposições</option>
        <option value="reunioes">Reuniões</option>
        <option value="projetos-culturais">Projetos culturais</option>
        <option value="aulas-musicais">Aulas e atividades musicais</option>
        <option value="palestras">Palestras</option>
    </select>


    {{!-- <input type="date" name="data" id="filtro-data"> --}}
    <select name="data">
        <option value="" disabled selected>Data</option>
        <option value="hoje">Hoje</option>
        <option value="esta-semana">Esta Semana</option>
        <option value="este-mes">Este Mês</option>
        <option value="proximos-30-dias">Próximos 30 dias</option>
        <option value="2026">Ano de 2026</option>
    </select>    

    <select name="local">
        <option value="" disabled selected>Local</option>
        <option value="nuarte">NUARTE</option>
        <option value="biblioteca-ifrn">Biblioteca IFRN</option>
        <option value="espaco-cultural">Espaço Cultural</option>
        <option value="auditorio-ifrn">Auditório IFRN</option>
    </select>

      <select name="status">
        <option value="" disabled selected>Status</option>
        <option value="lotado">Lotado</option>
        <option value="disponivel">Disponível</option>
      </select>

        {{!-- Botao de limpar filtros --}}
      <button type="button" class="btn-limpar" onclick="limparFiltros()">Limpar Filtros</button>
    </section>

    <!-- Seção da Lista de Eventos -->
    <section class="panel">
      <div class="panel-head">
        <h2>Lista de Eventos</h2>
        <span class="badge">{{quantidadeEventos}} eventos encontrados</span>
      </div>

      <div class="grid">
        {{#if eventos.length}}
          {{#each eventos}}
            <article class="card">
              <div class="card-media">
                <img src="{{imagem}}" alt="{{titulo}}" loading="lazy" />
                <span class="tag tag-{{statusClass}}">{{status}}</span>
              </div>
              <div class="card-body">
                <h3>{{titulo}}</h3>
                <ul class="event-details">
                  <li><i class="fa-regular fa-calendar-days"></i> {{data}}</li>
                  <li><i class="fa-regular fa-clock"></i> {{horario}}</li>
                  <li><i class="fa-solid fa-location-dot"></i> {{localNome}}</li>
                  <li><i class="fa-solid fa-users"></i> Vagas: {{vagas}}</li>
                </ul>
                <div class="card-actions">
                  <button class="btn-outline" type="button" onclick="location.href='/events/{{id}}'"><i class="fa-regular fa-eye"></i>Visualizar</button>
          {{!-- Editar só fica ativo para eventos em Rascunho --}}
          {{#if podeEditar}}
            <button
              class="btn-outline btn-editar"
              type="button"
              data-action="{{editAction}}"
              data-name="{{titulo}}"
              data-description="{{descricao}}"
              data-category="{{categoriaValor}}"
              data-image="{{imagemUrl}}"
              data-start-date="{{form.startDate}}"
              data-start-time="{{form.startTime}}"
              data-end-date="{{form.endDate}}"
              data-end-time="{{form.endTime}}"
              data-location="{{local}}"
              data-spots="{{vagas}}"
              data-classroom-id="{{form.classroomId}}"
              onclick="abrirModalEditarEvento(this)"
            ><i class="fa-solid fa-pen-to-square"></i>Editar</button>
          {{/if}}
          {{#if podeExcluir}}
            <form action="{{deleteAction}}" method="POST" style="display: contents"
                  onsubmit="return confirm('Excluir este evento?')">
              <button class="btn-danger" type="submit" aria-label="Excluir"><i class="fa-regular fa-trash-can"></i></button>
            </form>
          {{/if}}
                </div>
              </div>
            </article>
          {{/each}}
        {{else}}
          <p>Nenhum evento cadastrado.</p>
        {{/if}}
      </div>

      <!-- Paginação -->
      <nav class="pagination">
        <button class="page-nav" type="button" disabled>‹ Anterior</button>
        <button class="page current" type="button">1</button>
        <button class="page" type="button">2</button>
        <button class="page-nav" type="button">Próxima ›</button>
      </nav>
    </section>

    {{> event-modal modalId="modalNovoEvento" modalTitle="Novo Evento" formAction="/events"}}

    {{!-- Modal de edição dos cards (o endereço de envio é definido pelo JS) --}}
    {{> event-modal modalId="modalEditarEvento" modalTitle="Editar Evento" formAction="/events"}}
    <script src="/javascripts/events.js" defer></script>