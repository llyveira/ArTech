   <!-- ===== Modal: Novo Evento ===== -->
<div class="modal-overlay hidden" id="modalNovoEvento" onclick="fecharModalNovoEvento()">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalNovoEventoTitle" onclick="event.stopPropagation()">
    <div class="modal-head">
      <h2 id="modalNovoEventoTitle">Novo Evento</h2>
      <button class="modal-close" type="button" aria-label="Fechar" onclick="fecharModalNovoEvento()">✕</button>
    </div>

    <form class="modal-form" action="/events" method="POST" enctype="multipart/form-data">
      <label class="field">
        <span>Nome do evento</span>
        <input type="text" name="name" placeholder="Ex: Oficina de Teatro" required />
      </label>

      <label class="field">
        <span>Descrição</span>
        <textarea name="description" rows="3" placeholder="Descreva o evento..." required></textarea>
      </label>

      <label class="field">
        <span>Categoria</span>
        <select name="category" required>
          <option value="" disabled selected>Selecione uma categoria</option>
          <option value="oficinas-artisticas">Oficinas artísticas</option>
          <option value="apresentacoes-culturais">Apresentações culturais</option>
          <option value="ensaios">Ensaios</option>
          <option value="exposicoes">Exposições</option>
          <option value="reunioes">Reuniões</option>
          <option value="projetos-culturais">Projetos culturais</option>
          <option value="aulas-musicais">Aulas e atividades musicais</option>
          <option value="palestras">Palestras</option>
        </select>
      </label>

      <label class="field">
        <span>Imagem</span>
        <input type="file" name="image" accept="image/*" />
      </label>

      <fieldset class="modal-fieldset">
        <legend>Reserva</legend>

        <div class="modal-grid-2">
          <label class="field">
            <span>Data</span>
            <input type="date" name="reservation_date" required />
          </label>
          <label class="field">
            <span>Horário</span>
            <input type="time" name="reservation_time" required />
          </label>
        </div>

        <label class="field">
          <span>Local</span>
          <select name="reservation_location" required>
            <option value="" disabled selected>Selecione o local</option>
            <option value="nuarte">NUARTE</option>
            <option value="biblioteca-ifrn">Biblioteca IFRN</option>
            <option value="espaco-cultural">Espaço Cultural</option>
            <option value="auditorio-ifrn">Auditório IFRN</option>
          </select>
        </label>

        <div class="modal-grid-2">
          <label class="field">
            <span>Responsável</span>
            <input type="text" name="reservation_responsible" placeholder="Nome do responsável" required />
          </label>
          <label class="field">
            <span>Vagas</span>
            <input type="text" name="reservation_spots" placeholder="Ex: 20 ou Livre" />
          </label>
        </div>

        <label class="field">
          <span>Contato</span>
          <input type="tel" name="reservation_contact" placeholder="(84) 90000-0000" />
        </label>
      </fieldset>

      <div class="modal-actions">
        <button type="button" class="btn-outline" onclick="fecharModalNovoEvento()">Cancelar</button>
        <button type="submit" class="btn-primary">Criar Evento</button>
      </div>
    </form>
  </div>
</div>

