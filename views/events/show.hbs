<section class="event-view">
  <a href="events" class="back-link">← Voltar para Eventos</a>

  <div class="event-view-card">
    <div class="event-view-media">
      <img src="{{evento.imagem}}" alt="{{evento.titulo}}">
      <span class="tag tag-{{evento.statusClass}}">{{evento.status}}</span>
    </div>

    <div class="event-view-body">
      <h1>{{evento.titulo}}</h1>

      <ul class="event-details">
        <li><i class="fa-regular fa-calendar-days"></i> <strong>Data de entrada:</strong> {{evento.dataEntrada}}</li>
        <li><i class="fa-regular fa-clock"></i> <strong>Horário de entrada:</strong> {{evento.horaEntrada}}</li>
        <li><i class="fa-regular fa-calendar-days"></i> <strong>Data de saída:</strong> {{evento.dataSaida}}</li>
        <li><i class="fa-regular fa-clock"></i> <strong>Horário de saída:</strong> {{evento.horaSaida}}</li>
        <li><i class="fa-solid fa-location-dot"></i> <strong>Local:</strong> {{evento.localNome}}</li>
        <li><i class="fa-solid fa-users"></i> <strong>Vagas:</strong> {{evento.vagas}}</li>
        {{#if evento.sala}}
          <li><i class="fa-solid fa-door-open"></i> <strong>Sala:</strong> {{evento.sala}}</li>
        {{/if}}
        {{#if evento.finalidade}}
          <li><i class="fa-regular fa-clipboard"></i> <strong>Finalidade:</strong> {{evento.finalidade}}</li>
        {{/if}}
        {{#if evento.statusReserva}}
          <li><i class="fa-solid fa-circle-check"></i> <strong>Reserva:</strong> {{evento.statusReserva}}</li>
        {{/if}}
        {{#if evento.responsible}}
          <li><i class="fa-regular fa-user"></i> <strong>Responsável:</strong> {{evento.responsible}}</li>
        {{/if}}
        {{#if evento.contact}}
          <li><i class="fa-regular fa-envelope"></i> <strong>Contato:</strong> {{evento.contact}}</li>
        {{/if}}
        <li><i class="fa-solid fa-tag"></i> <strong>Categoria:</strong> {{evento.categoria}}</li>
        {{#if evento.criador}}
          <li><i class="fa-regular fa-user"></i> <strong>Criado por:</strong> {{evento.criador}}</li>
        {{/if}}
      </ul>

      <p class="event-view-description">{{evento.descricao}}</p>

      <div class="event-view-actions">
               {{!-- Inscrição: só em evento Aprovado --}}
        {{#if evento.podeInscrever}}
          {{#if evento.inscrito}}
            <button type="button" class="btn-primary btn-inscrever btn-inscrito" disabled>
              <i class="fa-solid fa-circle-check"></i> Inscrito
            </button>
          {{else if currentUser}}
            <button type="button" class="btn-primary btn-inscrever" onclick="abrirModalEvento('modalInscricao')">Inscrever-se</button>
          {{else}}
            <a href="events/{{evento.id}}?register=1" class="btn-primary btn-inscrever">Inscrever-se</a>
          {{/if}}
        {{/if}}

        {{!-- Editar e "Criar Evento" só aparecem quando o status é Rascunho --}}
        {{#if evento.podeEditar}}
          <button
            type="button"
            class="btn-outline btn-editar"
            data-name="{{evento.titulo}}"
            data-description="{{evento.descricao}}"
            data-category="{{evento.categoriaValor}}"
            data-image="{{evento.imagemUrl}}"
            data-start-date="{{evento.form.startDate}}"
            data-start-time="{{evento.form.startTime}}"
            data-end-date="{{evento.form.endDate}}"
            data-end-time="{{evento.form.endTime}}"
            data-location="{{evento.local}}"
            data-spots="{{evento.vagas}}"
            data-classroom-id="{{evento.form.classroomId}}"
            onclick="abrirModalEditarEvento(this)"
          ><i class="fa-solid fa-pen-to-square"></i> Editar</button>
        {{/if}}

        {{#if evento.podeSolicitar}}
          <form action="events/{{evento.id}}/solicitar" method="POST">
            <button type="submit" class="btn-primary">Criar Evento</button>
          </form>
        {{/if}}

        {{!-- Aprovar e Rejeitar: só o coordenador, e só com o evento Solicitado --}}
        {{#if evento.podeValidar}}
          <form action="{{evento.approveAction}}" method="POST"
                onsubmit="return confirm('Aprovar este evento?')">
            <button type="submit" class="btn-primary">
              <i class="fa-solid fa-check"></i> Aprovar
            </button>
          </form>
          <form action="{{evento.rejectAction}}" method="POST"
                onsubmit="return confirm('Rejeitar este evento?')">
            <button type="submit" class="btn-outline btn-rejeitar">
              <i class="fa-solid fa-xmark"></i> Rejeitar
            </button>
          </form>
        {{/if}}

      </div>
    </div>
  </div>
</section>


{{#if evento.podeEditar}}
  {{> event-modal modalId="modalEditarEvento" modalTitle="Editar Evento" formAction=evento.editAction}}
{{/if}}

{{!-- Pop-up de inscrição: só para quem está logado e ainda não se inscreveu --}}
{{#if evento.podeInscrever}}
  {{#if currentUser}}
    {{#unless evento.inscrito}}
      <div class="modal-overlay hidden" id="modalInscricao" onclick="fecharModalEvento('modalInscricao')">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalInscricaoTitle" onclick="event.stopPropagation()">
          <div class="modal-head">
            <h2 id="modalInscricaoTitle">Inscrição no evento</h2>
            <button class="modal-close" type="button" aria-label="Fechar" onclick="fecharModalEvento('modalInscricao')">✕</button>
          </div>

          <form class="modal-form" action="events/{{evento.id}}/inscrever" method="POST">
            <p>Você está se inscrevendo em <strong>{{evento.titulo}}</strong>.</p>

            {{#if exigeMatricula}}
              <label class="field">
                <span>Matrícula</span>
                <input type="text" name="registration" value="{{currentUser.ifrn_registration}}" required />
              </label>
            {{/if}}

            <label class="field">
              <span>E-mail</span>
              <input type="email" name="email" value="{{currentUser.email}}" required />
            </label>

            <label class="field">
              <span>Nome completo</span>
              <input type="text" name="name" value="{{currentUser.name}}" required />
            </label>

            <label class="field">
              <span>Telefone</span>
              <input type="tel" name="phone" value="{{currentUser.phone}}" placeholder="(84) 99999-9999" required />
            </label>

            <div class="modal-actions">
              <button type="button" class="btn-outline" onclick="fecharModalEvento('modalInscricao')">Cancelar</button>
              <button type="submit" class="btn-primary">Confirmar inscrição</button>
            </div>
          </form>
        </div>
      </div>
    {{/unless}}
  {{/if}}
{{/if}}

<script src="javascripts/events.js" defer></script>